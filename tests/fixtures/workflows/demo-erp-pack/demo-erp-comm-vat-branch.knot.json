    "workflow": {
        "label": "DEMO-ERP-COMM-01 \u2014 VAT branch on thirdparty",
        "description": "Fetch societe by id; branch on tva_intra empty vs set (multi-node logic, no HTTP).",
        "definition": {
            "schemaVersion": "1.0",
            "workflow": {
                "ref": "DEMO_ERP_COMM_01",
                "label": "DEMO-ERP-COMM-01 \u2014 VAT branch on thirdparty",
                "tags": [
                    "demo-erp-pack",
                    "mono-tenant"

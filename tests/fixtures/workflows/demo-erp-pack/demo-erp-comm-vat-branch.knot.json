                },
                {
                    "id": "i_vat",
                    "type": "logic.if",
                    "label": "VAT intracom non-empty?",
                    "position": {
                        "x": 520,
                        "y": 120
                    },
                    "config": {
                        "mode": "all",
                        "conditions": [
                            {
                                "left": "{{$json.object.tva_intra}}",
                                "operator": "is_not_empty",
                                "right": ""
                            }
                        ]
                    }
                },
                {
                    "id": "a_eu",
                    "type": "notification.alert",
                    "label": "VAT intracom branch",
                    "position": {
                        "x": 760,
                        "y": 40
                    },
                    "config": {
                        "title": "Demo ERP \u2014 VAT classification",
                        "message": "intracom=yes id={{$json._passthrough.object.id}} ref={{$json._passthrough.object.ref}}",
                        "severity": "info",
                        "tag": "DEMO-ERP-VAT-HIGH",
                        "channels": {
                            "audit": {
                                "enabled": true
                            }
                        }
                    }
                },
                {
                    "id": "a_dom",
                    "type": "notification.alert",
                    "label": "Domestic VAT branch",
                    "position": {
                        "x": 760,
                        "y": 200
                    },
                    "config": {
                        "title": "Demo ERP \u2014 VAT classification",
                        "message": "intracom=no id={{$json._passthrough.object.id}} ref={{$json._passthrough.object.ref}}",
                        "severity": "info",
                        "tag": "DEMO-ERP-VAT-LOW",

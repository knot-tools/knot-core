                "settings": {
                    "timeoutSeconds": 180,
                    "errorPolicy": "stop",
                    "logPayloads": true
                }
            },
            "nodes": [
                {
                    "id": "t1",
                    "type": "trigger.manual",
                    "label": "Start",
                    "position": {
                        "x": 40,
                        "y": 120
                    },
                    "config": []
                },
                {
                    "id": "fetch_tp",
                    "type": "dolibarr.object",
                    "label": "Load thirdparty",
                    "position": {
                        "x": 280,
                        "y": 120
                    },
                    "config": {
                        "operation": "fetch",
                        "objectType": "thirdparty",

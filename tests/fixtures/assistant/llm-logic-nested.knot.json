{
  "knotExport": "1.0",
  "exportedAt": "2026-07-14T18:05:00Z",
  "exportedBy": "Knot Assistant",
  "workflow": {
    "label": "Assistant LLM — Nested logic (set/if/loop/switch)",
    "description": "Generated-style fixture: manual → set items → if → loop → switch → per-lane set → aggregate on loop done. Prefers $loop.item and $nodes.* (zero expression_json_chain).",
    "definition": {
      "schemaVersion": "1.0",
      "workflow": {
        "ref": "LLM_ASSISTANT_LOGIC_NESTED",
        "label": "Assistant LLM — Nested logic (set/if/loop/switch)",
        "tags": ["assistant", "llm-fixture", "logic", "lint-clean"],
        "settings": {
          "timeoutSeconds": 90,
          "errorPolicy": "stop",
          "logPayloads": true
        }
      },
      "nodes": [
        {
          "id": "trig",
          "type": "trigger.manual",
          "label": "Start",
          "subtitle": "Manual run",
          "position": { "x": 40, "y": 260 },
          "config": {}
        },
        {
          "id": "seed",
          "type": "logic.set",
          "label": "Seed ticket queue",
          "subtitle": "3 priority lanes",
          "position": { "x": 260, "y": 260 },
          "config": {
            "values": {
              "batch": "llm-demo-queue",
              "items": [
                { "ticket": "T-101", "priority": "high", "score": 92 },
                { "ticket": "T-102", "priority": "normal", "score": 40 },
                { "ticket": "T-103", "priority": "low", "score": 12 }
              ]
            }
          }
        },
        {
          "id": "if_has_items",
          "type": "logic.if",
          "label": "Queue non-empty?",
          "position": { "x": 500, "y": 260 },
          "config": {
            "mode": "all",
            "conditions": [
              {
                "left": "{{$nodes.seed.json.items}}",
                "operator": "is_not_empty",
                "right": ""
              }
            ]
          }
        },
        {
          "id": "empty_stub",
          "type": "logic.set",
          "label": "Empty queue exit",
          "position": { "x": 740, "y": 420 },
          "config": {
            "values": {
              "resolution": "empty-queue",
              "processed": 0
            }
          }
        },
        {
          "id": "loop_tickets",
          "type": "logic.loop",
          "label": "For each ticket",
          "subtitle": "realIteration",
          "position": { "x": 740, "y": 180 },
          "config": {
            "itemsPath": "{{$nodes.seed.json.items}}",
            "realIteration": true,
            "continueOnItemError": true,
            "maxItems": 20
          }
        },
        {
          "id": "prio_switch",
          "type": "logic.switch",
          "label": "Route by priority",
          "position": { "x": 1000, "y": 180 },
          "config": {
            "expression": "{{$loop.item.priority}}",
            "cases": [
              { "value": "high", "output": "case_1" },
              { "value": "normal", "output": "case_2" }
            ]
          }
        },
        {
          "id": "route_high",
          "type": "logic.set",
          "label": "Lane high",
          "position": { "x": 1260, "y": 60 },
          "config": {
            "values": {
              "ticket": "{{$loop.item.ticket}}",
              "priority": "{{$loop.item.priority}}",
              "score": "{{$loop.item.score}}",
              "lane": "ESCALATE",
              "slaHours": 4
            }
          }
        },
        {
          "id": "route_normal",
          "type": "logic.set",
          "label": "Lane normal",
          "position": { "x": 1260, "y": 180 },
          "config": {
            "values": {
              "ticket": "{{$loop.item.ticket}}",
              "priority": "{{$loop.item.priority}}",
              "score": "{{$loop.item.score}}",
              "lane": "STANDARD",
              "slaHours": 24
            }
          }
        },
        {
          "id": "route_low",
          "type": "logic.set",
          "label": "Lane low (default)",
          "position": { "x": 1260, "y": 300 },
          "config": {
            "values": {
              "ticket": "{{$loop.item.ticket}}",
              "priority": "{{$loop.item.priority}}",
              "score": "{{$loop.item.score}}",
              "lane": "BACKLOG",
              "slaHours": 72
            }
          }
        },
        {
          "id": "aggregate",
          "type": "logic.set",
          "label": "Aggregate results",
          "subtitle": "After loop done",
          "position": { "x": 860, "y": 40 },
          "config": {
            "values": {
              "batch": "{{$nodes.seed.json.batch}}",
              "count": "{{$nodes.loop_tickets.json.count}}",
              "items": "{{$nodes.loop_tickets.json.items}}",
              "template": "LLM_ASSISTANT_LOGIC_NESTED"
            }
          }
        }
      ],
      "edges": [
        {
          "id": "e_trig_seed",
          "source": "trig",
          "target": "seed",
          "sourceHandle": "main",
          "targetHandle": "main",
          "type": "knot"
        },
        {
          "id": "e_seed_if",
          "source": "seed",
          "target": "if_has_items",
          "sourceHandle": "main",
          "targetHandle": "main",
          "type": "knot"
        },
        {
          "id": "e_if_true_loop",
          "source": "if_has_items",
          "target": "loop_tickets",
          "sourceHandle": "true",
          "targetHandle": "main",
          "type": "knot"
        },
        {
          "id": "e_if_false_stub",
          "source": "if_has_items",
          "target": "empty_stub",
          "sourceHandle": "false",
          "targetHandle": "main",
          "type": "knot"
        },
        {
          "id": "e_loop_iter",
          "source": "loop_tickets",
          "target": "prio_switch",
          "sourceHandle": "iteration",
          "targetHandle": "main",
          "type": "knot"
        },
        {
          "id": "e_loop_done",
          "source": "loop_tickets",
          "target": "aggregate",
          "sourceHandle": "done",
          "targetHandle": "main",
          "type": "knot"
        },
        {
          "id": "e_sw_high",
          "source": "prio_switch",
          "target": "route_high",
          "sourceHandle": "case_1",
          "targetHandle": "main",
          "type": "knot"
        },
        {
          "id": "e_sw_normal",
          "source": "prio_switch",
          "target": "route_normal",
          "sourceHandle": "case_2",
          "targetHandle": "main",
          "type": "knot"
        },
        {
          "id": "e_sw_low",
          "source": "prio_switch",
          "target": "route_low",
          "sourceHandle": "default",
          "targetHandle": "main",
          "type": "knot"
        }
      ]
    }
  }
}

{
  "schemaVersion": "1.0",
  "workflow": {},
  "nodes": [
    {
      "id": "t_manual",
      "type": "trigger.manual",
      "label": "Start",
      "position": { "x": 60, "y": 140 },
      "config": {}
    },
    {
      "id": "s_kind",

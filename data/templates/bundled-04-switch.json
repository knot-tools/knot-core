      "targetHandle": "main",
      "type": "success"
    },
    {
      "id": "e2",
      "source": "s_kind",
      "target": "sw",
      "sourceHandle": "main",
      "targetHandle": "main",
      "type": "success"
    },
    {
      "id": "e3",
      "source": "sw",
      "target": "s_out",

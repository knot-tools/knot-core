          { "value": "alpha", "output": "case_1" },
          { "value": "beta", "output": "case_2" }
        ]
      }
    },
    {
      "id": "s_out",
      "type": "logic.set",
      "label": "Result",
      "position": { "x": 820, "y": 140 },
      "config": { "values": { "picked": "switch-done" } }

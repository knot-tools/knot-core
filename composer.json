{
    "name": "knot/dolibarr-module",
    "description": "Knot — Dolibarr visual workflow automation module (development tooling).",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4"
    },
    "autoload": {
        "psr-4": {
            "Knot\\": "class/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Knot\\Tests\\": "tests/",
            "Knot\\Tests\\E2E\\": "tests/e2e/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --coverage-text",
        "docs:openapi": "php scripts/generate_openapi.php"
    }
}

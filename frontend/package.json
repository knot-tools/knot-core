{
  "name": "knot-frontend",
  "private": true,
  "version": "2.13.12",
  "description": "Knot frontend bundle — visual workflow editor for Dolibarr",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.vue\" --max-warnings 0",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "lint:i18n:compile": "node scripts/lint-i18n-compile.mjs",
    "lint:i18n:loanwords": "node scripts/lint-i18n-loanwords.mjs",
    "i18n-check": "node scripts/i18n-check.mjs",
    "audit:i18n:core": "node ../scripts/audit-i18n-fr-en.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@dagrejs/dagre": "^3.0.0",
    "@types/dagre": "^0.7.54",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.41.6",
    "@vue-flow/minimap": "^1.5.0",
    "@vueuse/core": "^11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.1",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.2.6",
    "tailwind-merge": "^2.5.4",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.0",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.13",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.1.10"
